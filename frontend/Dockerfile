FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite port
EXPOSE 5173

# Run dev server with host flag to allow external access
# Wait for contracts to be generated by the chain service
CMD sh -c "while [ ! -f src/contracts/CharityToken.json ]; do echo 'Waiting for contracts...'; sleep 2; done; npm run dev -- --host"
